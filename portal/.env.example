# Copiá este archivo a .env (no se sube a git). En Railway, cargá estas variables en el servicio.
PORT=3000
NODE_ENV=development

# Ruta del archivo SQLite. En Railway, apuntala al Volume (por ejemplo /data/pandora.db).
DATABASE_PATH=./data/pandora.db

# Sitio público servido en "/". Por defecto ../pandora-opcion-a
# PUBLIC_SITE_DIR=../pandora-opcion-a

# Duración de la sesión en horas e intentos de login fallidos por IP cada 15 min.
SESSION_HOURS=8
LOGIN_LIMIT=10

# Usuarios iniciales para `npm run seed`. Si falta una contraseña, se genera y se muestra una vez.
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=
SEED_CLIENT_USER=sbase
SEED_CLIENT_PASSWORD=
